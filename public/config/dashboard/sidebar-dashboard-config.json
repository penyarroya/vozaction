{
  "version": "1.0.1",
  "metadata": {
    "title": "Gestión de Entidades",
    "description": "Configuración del sidebar para el dashboard",
    "lastUpdated": "2026-09-04T10:00:00Z",
    "author": "Admin",
    "environment": "development"
  },
  "sidebar": {
    "defaultWidth": 260,
    "minWidth": 60,
    "maxWidth": 400,
    "defaultFontSize": 14,
    "defaultOpen": true,
    "breakpoints": {
      "mobile": {
        "width": 280,
        "position": "overlay",
        "defaultOpen": false
      },
      "tablet": {
        "width": 240,
        "position": "push",
        "defaultOpen": true
      },
      "desktop": {
        "width": 260,
        "position": "fixed",
        "defaultOpen": true
      }
    },
    "theming": {
      "colors": {
        "background": "var(--surface-container)",
        "hover": "var(--surface-container-hover)",
        "active": "var(--primary-container)",
        "text": "var(--on-surface)",
        "textActive": "var(--on-primary-container)",
        "border": "var(--outline-variant)"
      },
      "sizes": {
        "padding": "16px",
        "gap": "4px",
        "borderRadius": "12px",
        "iconSize": "22px"
      }
    }
  },
  "groups": [
    {
      "id": "main",
      "label": "Principal",
      "order": 1,
      "icon": "home",
      "items": ["dashboard", "UserEntity"]
    },
    {
      "id": "administration",
      "label": "Administración",
      "order": 2,
      "icon": "admin_panel_settings",
      "roles": ["ADMIN", "SUPER_ADMIN"],
